+ * @returns {{ apiKey, sessionToken, name, email, accountId, orgs, apiServerUrl }}
+ */
+export async function windsurfAuth1PostAuth(emailInput, auth1TokenInput, proxy = null, opts = {}) {
+  const email = String(emailInput || '').trim();
+  const auth1Token = String(auth1TokenInput || '').trim();
+  if (!email || !email.includes('@')) throw new Error('email 为必填，且必须是有效邮箱');
+  if (!auth1Token) throw new Error('auth1 token 为必填');
+  if (!auth1Token.startsWith('auth1_')) throw new Error('auth1 token 格式不正确');
+
+  log.info(`Windsurf Auth1 post-auth: ${email} proxy=${proxy?.host || 'global/none'}`);
+
+  const postAuth = await windsurfPostAuthWithRetry(auth1Token, opts.orgId || '', proxy);
+  const apiKey = normalizeSessionToken(postAuth.sessionToken);
+
+  log.info(`Windsurf Auth1 post-auth OK: ${email}, account=${postAuth.accountId || '-'}, token=${maskSecret(apiKey)}`);
+
+  return {
+    apiKey,
+    sessionToken: apiKey,
+    name: email,
+    email,
+    accountId: postAuth.accountId || '',
+    orgs: postAuth.orgs || [],
+    primaryOrgId: postAuth.primaryOrgId || '',
+    requiresOrgSelection: !opts.orgId && (postAuth.orgs || []).length > 1,
+    apiServerUrl: 'https://server.self-serve.windsurf.com',
+  };
+}
